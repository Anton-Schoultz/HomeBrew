#ifdef hide 					; ConLCD
.NOLIST
#endif
;=================================================================== CONLCD =========== 
; Hardware Console LCD / Keyboard
;
;*  ConIn                Read character from input (keyboard), null if none
;*  ConInit              Initialise console
;*  ConOut               Write character to output, check for CLS, TAB etc
;*  LcdBusy              Check if the LCD module is busy
;*  LcdClr               LcdClr 	LCD screen
;*  LcdCmd               Send a command .A to the module
;*  LcdData              Send data byte .A to the LCD module
;*  LcdInit              Initialise the LCD Module
;*

; Print to screen, Read from keyboard
IO_AREA 	= $0300 			; Must match Simulator's Options screen.

; base address where lcd is connected
LCDBASE 	= $0300



#define _NEED_STATEMACHINE
#define _NEED_KEYBUFFER

LCD_CMD 	= LCDBASE
LCD_DATA 	= LCDBASE + 1

_ConLCD 	= $

;------------------------------------------------------- ConInit 
ConInit: ; Initialise console
;  > initialise the LCD
;  > clear screen
;  > register key buffer state machine
 		rts

;------------------------------------------------------- ConOut 
ConOut: ;Write character to output, check for CLS, TAB etc
 		cmp 	#_FF 			; Form Feed = Clear Screen
 		beq 	ConCls
 		cmp 	#HT 			; TAB char
 		beq 	ConDoTab
 		jmp 	ConOut 			; send char to screen

;------------------------------------------------------- ConCls 
ConCls 		; Clear Screen (CLS / FormFeed)
 		rts

;------------------------------------------------------- ConDoTab 
ConDoTab 	; tab the output
 		lda 	#' '
 		jsr 	ConOut 			; send char to screen
 		;-- check tab pos
 		jsr 	ConPos
 		and 	#7
 		bne 	ConDoTab
 		rts
;------------------------------------------------------- ConSend 
ConSend 	; Send character to the screen
; > Output a character to the screen
 		rts

;------------------------------------------------------- ConIn 
ConIn: ; Read character from input (keyboard), null if none
; > jmp to dequeue a char from keybuffer
 		rts

;------------------------------------------------------- ConPos 
ConPos 		; Return screen column position in .A
; > get column number from LCD screen
 		rts

;------------------------------------------------------- ConTab 
ConTab 		; Set screen column to .A
; > set LCD screen column
 		rts

;=================================================================== LCD MODULE ======= 

;------------------------------------------------------- LcdBusy 
LcdBusy: ; Check if the LCD module is busy
LcdBusyL 	lda 	LCD_CMD
 		bmi 	LcdBusyL 		; bit 7 is busy bit
 		rts
;------------------------------------------------------- LcdCmd 
LcdCmd: ; Send a command .A to the module
 		pha 				; save cmd byte
 		jsr 	LcdBusy 		; wait until ready
 		pla 				; recall command
 		sta 	LCD_CMD 		; send it
 		rts 				; done

;------------------------------------------------------- LcdData 
LcdData: ; Send data byte .A to the LCD module
 		pha 				; save data
 		jsr 	LcdBusy 		; wait until ready
 		pla 				; recall data
 		sta 	LCD_DATA 		; send it
 		rts 				; done

;------------------------------------------------------- LcdInit 
LcdInit: ; Initialise the LCD Module
 		ldx 	#$04 			;do function set 4 times
LcdInit0 	lda 	#$38 			;function set: 8 bit, 2 lines, 5x7
 		jsr 	LcdCmd
 		dex
 		bne 	LcdInit0

 		lda 	#$06 			;entry mode set: increment, no shift
 		jsr 	LcdCmd
 		lda 	#$0E 			;display on, cursor on, blink off
 		jsr 	LcdCmd
 		lda 	#$01 			;clear display
 		jsr 	LcdCmd
 		lda 	#$80 			;DDRAM address set: $00
 		jsr 	LcdCmd
 		;-- fall through to clear screen

;------------------------------------------------------- LcdClear 
LcdClr: ; LcdClr 	LCD screen
 		pha
 		lda 	#$01
 		jsr 	LcdCmd
 		lda 	#$80
 		jsr 	LcdCmd
 		pla
 		rts



.LIST 						;-- End of ConLCD

