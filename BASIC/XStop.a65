.list
#ifdef hide
.NOLIST
#endif
#if (($/256)>=PG_ROM) & (($/256)<PG_KEY)
;=================================================================== STOP ============ 
;*  X_STOP               STOP~STOP executing the program
;*

_STOP 		= $

;------------------------------------------------------- X_STOP 
X_STOP: ; STOP~STOP executing the program
 		jmp 	Main 			; resets stack etc

; Warm Start = Reset Stack,Init Chr,Str,Calc,Devices

#if _LEVEL >= _KEYWORDS
.echo "  _STOP\t\t"
.echo $-_STOP
.echo "\n"
#endif

.nolist
#endif

;------------------------------------------------------- keyword 
#if ($/256) = PG_KEY

.list
W_STOP 		.DB 	"STO",'P'+$80
.nolist
#endif

;------------------------------------------------------- run 
#if ($/256) = PG_RUN
.list
T_STOP 		= LOW($)+$80
.DW 	X_STOP
.nolist
#endif
.list 						; end of STOP
